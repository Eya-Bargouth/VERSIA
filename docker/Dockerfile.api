FROM python:3.11-slim

WORKDIR /app

# Dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends     gcc     libpq-dev     curl     && rm -rf /var/lib/apt/lists/*

# Python deps
COPY pyproject.toml ./
COPY src/ ./src/

ENV PIP_DEFAULT_TIMEOUT=300
# torch ET torchvision ensemble, depuis le même index CPU : torchvision tiré
# séparément par pip install -e "." (transitif via docling/unstructured)
# viendrait du PyPI standard, compilé contre un torch CUDA-capable — ses
# extensions compilées (ex. l'op torchvision::nms) ne correspondent alors
# plus au build +cpu de torch, et tout code touchant torchvision plante à
# l'exécution (RuntimeError: operator torchvision::nms does not exist),
# y compris transformers.image_utils, importé même pour des modèles
# texte-only comme BGE-M3.
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -e "."

# Code source (monté en volume en dev, copié en prod)
COPY src/ ./src/

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
