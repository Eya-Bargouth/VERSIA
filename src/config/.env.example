# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=trade_chunks

# LLM (Ollama par défaut)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DENSE_DIM=1024

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Chunking
CHUNK_CONTEXTUAL_PREFIX_MAX_TOKENS=100

# Paths
RAW_DATA_DIR=./raw
VERSIONING_DIR=./tests/fixtures/versioning

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
